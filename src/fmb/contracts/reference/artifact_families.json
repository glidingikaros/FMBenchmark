    "ntfs.logfile": {
      "display_name": "NTFS Transaction Log",
      "logical_sources": [
        "$LogFile"
      ],
      "extractor_id": "fmb.index.scanners.logfile_runtime.dfir_ntfs",
      "supported_export_formats": [
        "e01"
      ],
      "retrieval_mode": "reference_only",
      "chunking_policy": "reference_only",
      "collection": {
        "windows": {
          "targets": [
            {
              "target_id": "ntfs.logfile.raw",
              "mode": "raw_file",
              "logical_source": "/$LogFile",
              "output_name": "$LogFile",
              "status": "active",
              "profile_role": "support_artifact",
              "scenario_ids": [
                "timestomp_01",
                "usn_journal_01"
              ],
              "rationale": "Preserve the raw NTFS transaction log; the locked dfir_ntfs driver binds retained $STANDARD_INFORMATION updates (undo = original, redo = new timestamps) to the exact object and reports the retained LSN range and embedded USN window.",
              "known_blind_spots": [
                "The log is circular: transactions older than the retained window are gone and their absence is never evidence.",
                "USN records embedded in log pages and $I30 index-entry remnants are parsed but not yet bound to criteria (phase C4/C5).",
                "Raw $LogFile collection does not by itself establish timestamp, delete, or rename intent."
              ],
              "parser_state": "raw_export_parsed_by_locked_dfir_ntfs_subprocess_with_optional_ntfslogtracker_context",
              "validation_state": "size_hash_validated_si_updates_bound_to_byte_matched_mft_records"
            }
          ]
        }
      }
    },
