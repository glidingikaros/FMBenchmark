{
  "$schema": "../schemas/reference.schema.json",
  "schema_version": "artifact_family_reference.v1",
  "artifact_families": {
    "ntfs.mft": {
      "display_name": "NTFS Master File Table",
      "logical_sources": [
        "$MFT"
      ],
      "extractor_id": "pending.extractor.ntfs.mft",
      "supported_export_formats": [
        "e01"
      ],
      "retrieval_mode": "reference_only",
      "chunking_policy": "reference_only",
      "collection": {
        "windows": {
          "targets": [
            {
              "target_id": "ntfs.mft.raw",
              "mode": "raw_file",
              "logical_source": "/$MFT",
              "output_name": "$MFT.bin",
              "sidecar_mode": "mft_record_index",
              "sidecar_output_name": "mft_records.index.json",
              "sidecar_coverage_status": "full_volume_mft_index",
              "sidecar_scan_strategy": "mft_record_attribute_inventory",
              "status": "active",
              "profile_role": "primary_evidence",
              "scenario_ids": [
                "timestomp_01",
                "directory_cleaning_i30_01",
                "ads_injection_01",
                "bitmap_trailing_data_01",
                "prefetch_wipe_01",
                "shimcache_path_residue_01",
                "usn_journal_01",
                "typed_path_residue_01",
                "shellbag_path_residue_01",
                "ntfs_allocation_01"
              ],
              "rationale": "Preserve the raw NTFS Master File Table for timestamp-bearing metadata and later SI/FN comparison.",
              "known_blind_spots": [
                "Structured MFT record inventory is a substrate only and does not make timestomp or SI/FN anomaly claims.",
                "No independent cross-parser validation is recorded yet."
              ],
              "parser_state": "raw_export_with_mft_record_index",
              "validation_state": "size_hash_and_record_index_validated"
            }
          ]
        }
      }
    },
    "ntfs.ads": {
      "display_name": "NTFS Alternate Data Streams",
      "logical_sources": [
        "$MFT named stream metadata"
      ],
      "extractor_id": "pending.extractor.ntfs.ads",
      "supported_export_formats": [
        "e01"
      ],
      "retrieval_mode": "reference_only",
      "chunking_policy": "reference_only",
      "collection": {
        "windows": {
          "targets": [
            {
              "target_id": "ntfs.ads.mft_named_data_index",
              "mode": "mft_named_data_index",
              "logical_source": "/$MFT",
              "output_name": "named_data_streams.index.json",
              "coverage_status": "full_volume_mft_index",
              "scan_strategy": "mft_named_data_attributes",
              "content_materialization": "bounded_roots",
              "materialize_roots": [
                "/Users/vagrant/Desktop"
              ],
              "limits": {
                "stream_export_limit_bytes": 8388608
              },
              "full_volume_supported": true,
              "status": "active",
              "profile_role": "primary_evidence",
              "scenario_ids": [
                "ads_injection_01"
              ],
              "rationale": "Enumerate named NTFS $DATA attributes through the MFT so ADS coverage is independent of recursive path walking.",
              "known_blind_spots": [
                "Stream content materialization is bounded to explicit roots.",
                "No independent ADS parser or Windows dir /r comparison is recorded yet."
              ],
              "parser_state": "metadata_index_with_bounded_content_export",
              "validation_state": "fixture_validated_cross_parser_pending"
            }
          ]
        }
      }
    },
    "ntfs.usn": {
      "display_name": "NTFS USN Journal",
      "logical_sources": [
        "$UsnJrnl:$J"
      ],
      "extractor_id": "pending.extractor.ntfs.usn",
      "supported_export_formats": [
        "e01"
      ],
      "retrieval_mode": "reference_only",
      "chunking_policy": "reference_only",
      "collection": {
        "windows": {
          "targets": [
            {
              "target_id": "ntfs.usn.j_external_reference",
              "mode": "named_attribute_reference",
              "logical_source": "/$Extend/$UsnJrnl",
              "attribute_name": "$J",
              "output_name": "$UsnJrnl-$J.bin",
              "status": "active",
              "profile_role": "primary_evidence",
              "scenario_ids": [
                "timestomp_01",
                "directory_cleaning_i30_01",
                "usn_journal_01"
              ],
              "rationale": "Reference the USN journal stream needed for journal-backed deletion persistence evidence.",
              "known_blind_spots": [
                "Bounded exact-reference USN parsing is limited to the registered truth-blind candidate population; full journal reconstruction is outside the active claim.",
                "Oversized journal content is referenced with an explicit size-threshold policy rather than fully exported."
              ],
              "parser_state": "named_attribute_reference_with_bounded_record_index",
              "validation_state": "fixture_validated_cross_parser_pending"
            }
          ]
        }
      }
    },
    "windows.registry.typed_paths": {
      "display_name": "Windows TypedPaths Registry Values",
      "logical_sources": [
        "Users/vagrant/NTUSER.DAT"
      ],
      "extractor_id": "pending.extractor.windows.registry.typed_paths",
      "supported_export_formats": [
        "e01"
      ],
      "retrieval_mode": "reference_only",
      "chunking_policy": "reference_only",
      "collection": {
        "windows": {
          "targets": [
            {
              "target_id": "windows.registry.typed_paths.ntuser_raw_hive",
              "mode": "raw_file",
              "logical_source": "/Users/vagrant/NTUSER.DAT",
              "output_name": "NTUSER.DAT",
              "status": "active",
              "profile_role": "primary_evidence",
              "scenario_ids": [
                "typed_path_residue_01"
              ],
              "rationale": "Collect the complete user hive and normalize absolute local-path values from Explorer\\TypedPaths.",
              "known_blind_spots": [
                "Only structured TypedPaths values enter the bounded claim; other MRU and shell-artifact records are excluded.",
                "Hive transaction logs (.LOG1/.LOG2) are collected with the hive; the Zimmerman registry parsers replay them into a dirty hive before parsing.",
                "TypedPaths residue plus current absence does not establish access, deletion, or intent."
              ],
              "parser_state": "raw_export_with_typed_paths_parser",
              "validation_state": "fixture_validated_cross_parser_pending"
            }
          ]
        }
      }
    },
